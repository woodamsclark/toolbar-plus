    "release": "npm run check && node scripts/package-release.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "obsidian": "^1.8.7",
    "prettier": "^3.9.6",
    "typescript": "^5.8.0"
  }
}
