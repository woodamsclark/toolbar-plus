{
  "name": "toolbar-plus",
  "version": "0.1.17",
  "private": true,
  "license": "MPL-2.0",
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.*",
    "build:preview": "node tests/build-preview.mjs",
